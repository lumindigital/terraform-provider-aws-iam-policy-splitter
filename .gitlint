# .gitlint
# BE ADVISED: This file was @generated by the Lumin Digital lumin-stencil project
# For more information, please see: https://github.com/Lumin-Digital/lumin-stencil
[general]
ignore=body-is-missing, body-max-line-length, B2, B4

[title-match-regex]
regex=(DEV-\d+|SECENGR-\d+|LA-\d+|SRE-\d+|ACK|merge)

[ignore-by-author-name]
regex=(.*)dependabot(.*)
ignore=all

